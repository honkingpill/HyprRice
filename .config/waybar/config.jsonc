// -*- mode: jsonc -*-
{
    // Position
    "position": "left",
    //"height": , 
    "margin-left": 5,
    "margin-top": 10,
    "margin-bottom": 10,
    "width": 40,
    "mode": "dock",
    "spacing": 10,
    // Loading Modules 
    "include": ["~/.config/waybar/modules.jsonc"],

    // Left modules (top)
    "modules-left": [
        "custom/apps",
        "hyprland/workspaces"
    ],

    // Center modules
    "modules-center": [
	       "hyprland/window"
 ],

    // Right modules (bottom)
    "modules-right": [
        "group/pipewire",
        "group/hardware",
        "backlight",
        "group/time",
        "group/notifications"
    ],
    // Groups
    "group/time":{
        "orientation": "vertical",
        "modules": [
            "hyprland/language",
            "clock"
        ]
    },
    "group/pipewire": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration":800,
            "children-class": "drawwire",
            "transition-left-to-right": false
        },
        "modules": [  
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "group/hardware": {
        "orientation":"vertical",
        "drawer": {
            "transition-duration":800,
            "children-class": "drawhard",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "memory",
            "network",
            "cpu",
            "disk"
        ]
    },
    "group/notifications":{
        "orientation":"vertical",
        "modules": [
            "tray",
            "custom/notification",
            "custom/power"
        ]
    }
}
